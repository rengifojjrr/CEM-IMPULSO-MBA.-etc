# Copia este archivo a `.env` y rellena el secreto.
#
# CEM_PUENTE_SECRETO es una frase larga que te inventas. Tiene que ser LA MISMA
# aquí y en Supabase → Edge Functions → Secrets. Es lo único que impide que
# cualquiera que sepa la dirección de la función diga «soy el teléfono de
# fulano, dame sus cuotas»: sin ella, la función rechaza la llamada.
CEM_PUENTE_SECRETO=

# escucha  -> anota lo que preguntan y NO contesta. Empieza siempre por aquí.
# responde -> anota y contesta.
CEM_PUENTE_MODO=escucha

# Se cambian sólo si hace falta.
CEM_CEREBRO_URL=https://vajbsfgojtunamhrzrpf.supabase.co/functions/v1/cem-whatsapp
CEM_PUENTE_PUERTO=3000
CEM_PUENTE_AUTH=./auth
